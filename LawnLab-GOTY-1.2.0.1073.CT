                  <Description>"Scrollable seed-card pages"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
showMessage("Scrollable seed-card pages\n\nExisting native bank count is never increased above ten. Packet base = Bank+28+i*50. Per-packet fields: elapsed+24, total+28, type+34, imitater+38, active+48, refreshing+49, timesUsed+4C. Hidden cooldowns use Board+5580 game ticks. Main Menu/lawn transitions invalidate the deck; cursor=[Board+150], cursor type+30 must be zero before a page change. Full deck/overlay workflow is in the GUI.")
{$asm}
[DISABLE]
</AssemblerScript>
                </CheatEntry>
