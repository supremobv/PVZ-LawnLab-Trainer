local value=inputQuery('LawnLab CT','plant_size: 25–300 percent; 100 normal','100')
if value then assert(value:match('^%d+$'),'Use an integer');LawnLabCE.command('VALUE|plant_size|'..value) end
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end

{$asm}</AssemblerScript>
