    local token=string.format('%08x%08x%08x%08x',getCheatEngineProcessID(),os.time(),math.random(0,0x7fffffff),math.random(0,0x7fffffff))
    local folder=assert(os.getenv('LOCALAPPDATA'))..'\\LawnLab\\ce\\'..token..'\\'
