  if _G.LawnLabCE.timer then _G.LawnLabCE.timer.destroy()end
  _G.LawnLabCE=nil
end
if not _G.LawnLabCE then
  local R={version='5.14',serial=0,busy=false,records={["almanac_reveal"]=42,["auto_cob"]=47,["auto_coins"]=20,["auto_collect"]=19,["bullet_changer"]=50,["cattail_land"]=37,["collect_1000_sun"]=21,["direct_upgrades"]=38,["extended_bank"]=27,["fast_belt"]=67,["fast_shoot"]=49,["infinite_sun"]=17,["instant_mines"]=35,["instant_plant_death"]=75,["invincible_plants"]=45,["invincible_zombies"]=55,["limbo_page"]=30,["lock_butter"]=63,["lock_shovel"]=68,["money_changer"]=25,["move_zombie_row"]=56,["mushrooms_awake"]=62,["no_cooldown"]=43,["no_crater"]=64,["no_fog"]=60,["no_ice_trail"]=65,["no_support"]=36,["one_hit_kill"]=52,["plant_anywhere"]=44,["plant_changer"]=46,["plant_size"]=39,["planting_adds_sun"]=22,["prevent_spend"]=18,["rapid_fire"]=48,["run_in_background"]=59,["see_vase"]=61,["shop_stock"]=26,["show_all_zombies"]=58,["snail_boost"]=29,["stop_spawning"]=54,["stop_zombies"]=53,["sun_lock"]=23,["sunflower_drop"]=34,["unhittable_plants"]=51,["unlock_sun_limit"]=24,["zombie_not_explode"]=66,["zombie_size"]=41}}
  _G.LawnLabCE=R
  local function read(path)
    local f=io.open(path,'rb');if not f then return nil end
    local s=f:read('*a');f:close();return s
  end
  local function write(path,text)
    local f=assert(io.open(path,'wb'),'Cannot write CT session file');f:write(text);f:close()
  end
  local function waitFile(path,ms)
    local untilTick=getTickCount()+ms
    repeat
      local text=read(path);if text then return text end
      sleep(30);processMessagesPaintOnly()
    until getTickCount()&gt;untilTick
    error('LawnLab CT helper did not respond. Reopen the controller after checking its status.')
  end
  function R.start()
    if R.folder and read(R.folder..'stopped')then
      R.folder=nil
      if R.timer then R.timer.destroy();R.timer=nil end
    end
    if R.folder then
      assert(getOpenedProcessID()==R.pid,'CE process changed. Stop this CT session before switching games.')
      return
    end
    R.pid=getOpenedProcessID();assert(R.pid and R.pid&gt;0,'Select the supported PVZ process in CE first.')
    local dialog=createOpenDialog(nil)
    dialog.Title='Select the matching LawnLab 5.14 executable'
